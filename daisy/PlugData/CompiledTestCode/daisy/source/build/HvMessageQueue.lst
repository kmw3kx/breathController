  81:HvMessageQueue.c **** 
  82:HvMessageQueue.c **** HvMessage *mq_addMessageByTimestamp(HvMessageQueue *q, const HvMessage *m, int let,
  83:HvMessageQueue.c ****     void (*sendMessage)(HeavyContextInterface *, int, const HvMessage *)) {
  84:HvMessageQueue.c ****   if (mq_hasMessage(q)) {
  85:HvMessageQueue.c ****     MessageNode *n = mq_getOrCreateNodeFromPool(q);
  86:HvMessageQueue.c ****     n->m = mp_addMessage(&q->mp, m);
  87:HvMessageQueue.c ****     n->let = let;
  88:HvMessageQueue.c ****     n->sendMessage = sendMessage;
  89:HvMessageQueue.c **** 
  90:HvMessageQueue.c ****     if (msg_getTimestamp(m) < msg_getTimestamp(q->head->m)) {
  91:HvMessageQueue.c ****       // the message occurs before the current head
  92:HvMessageQueue.c ****       n->next = q->head;
  93:HvMessageQueue.c ****       q->head->prev = n;
  94:HvMessageQueue.c ****       n->prev = NULL;
  95:HvMessageQueue.c ****       q->head = n;
  96:HvMessageQueue.c ****     } else if (msg_getTimestamp(m) >= msg_getTimestamp(q->tail->m)) {
  97:HvMessageQueue.c ****       // the message occurs after the current tail
  98:HvMessageQueue.c ****       n->next = NULL;
  99:HvMessageQueue.c ****       n->prev = q->tail;
 100:HvMessageQueue.c ****       q->tail->next = n;
 101:HvMessageQueue.c ****       q->tail = n;
 102:HvMessageQueue.c ****     } else {
 103:HvMessageQueue.c ****       // the message occurs somewhere between the head and tail
 104:HvMessageQueue.c ****       MessageNode *node = q->head;
 105:HvMessageQueue.c ****       while (node != NULL) {
 106:HvMessageQueue.c ****         if (msg_getTimestamp(m) < msg_getTimestamp(node->next->m)) {
 107:HvMessageQueue.c ****           MessageNode *r = node->next;
 108:HvMessageQueue.c ****           node->next = n;
 109:HvMessageQueue.c ****           n->next = r;
 110:HvMessageQueue.c ****           n->prev = node;
 111:HvMessageQueue.c ****           r->prev = n;
 112:HvMessageQueue.c ****           break;
 113:HvMessageQueue.c ****         }
 114:HvMessageQueue.c ****         node = node->next;
 115:HvMessageQueue.c ****       }
 116:HvMessageQueue.c ****     }
 117:HvMessageQueue.c ****     return n->m;
 118:HvMessageQueue.c ****   } else {
 119:HvMessageQueue.c ****     // add a message to the head
 120:HvMessageQueue.c ****     return mq_addMessage(q, m, let, sendMessage);
 121:HvMessageQueue.c ****   }
 122:HvMessageQueue.c **** }
 123:HvMessageQueue.c **** 
 124:HvMessageQueue.c **** void mq_pop(HvMessageQueue *q) {
 125:HvMessageQueue.c ****   if (mq_hasMessage(q)) {
 126:HvMessageQueue.c ****     MessageNode *n = q->head;
 127:HvMessageQueue.c **** 
 128:HvMessageQueue.c ****     mp_freeMessage(&q->mp, n->m);
 129:HvMessageQueue.c ****     n->m = NULL;
 130:HvMessageQueue.c **** 
 131:HvMessageQueue.c ****     n->let = 0;
 132:HvMessageQueue.c ****     n->sendMessage = NULL;
 133:HvMessageQueue.c **** 
ARM GAS  C:\Users\bobka\AppData\Local\Temp\ccjKP0sy.s 			page 8


 134:HvMessageQueue.c ****     q->head = n->next;
 135:HvMessageQueue.c ****     if (q->head == NULL) {
 136:HvMessageQueue.c ****       q->tail = NULL;
 137:HvMessageQueue.c ****     } else {
 138:HvMessageQueue.c ****       q->head->prev = NULL;
 139:HvMessageQueue.c ****     }
 140:HvMessageQueue.c ****     n->next = q->pool;
 141:HvMessageQueue.c ****     n->prev = NULL;
 142:HvMessageQueue.c ****     q->pool = n;
 143:HvMessageQueue.c ****   }
 144:HvMessageQueue.c **** }
