 220:../../libdaisy/src/dev/oled_ssd130x.h ****   private:
 221:../../libdaisy/src/dev/oled_ssd130x.h ****     void SoftSpiTransmit(uint8_t val)
 222:../../libdaisy/src/dev/oled_ssd130x.h ****     {
 223:../../libdaisy/src/dev/oled_ssd130x.h ****         // bit flip
 224:../../libdaisy/src/dev/oled_ssd130x.h ****         val = ((val & 0x01) << 7) | ((val & 0x02) << 5) | ((val & 0x04) << 3)
 225:../../libdaisy/src/dev/oled_ssd130x.h ****               | ((val & 0x08) << 1) | ((val & 0x10) >> 1) | ((val & 0x20) >> 3)
 226:../../libdaisy/src/dev/oled_ssd130x.h ****               | ((val & 0x40) >> 5) | ((val & 0x80) >> 7);
 227:../../libdaisy/src/dev/oled_ssd130x.h **** 
 228:../../libdaisy/src/dev/oled_ssd130x.h ****         for(uint8_t bit = 0u; bit < 8u; bit++)
 229:../../libdaisy/src/dev/oled_ssd130x.h ****         {
 230:../../libdaisy/src/dev/oled_ssd130x.h ****             pin_mosi_.Write((val & (1 << bit)) ? 1 : 0);
 231:../../libdaisy/src/dev/oled_ssd130x.h **** 
 232:../../libdaisy/src/dev/oled_ssd130x.h ****             System::DelayTicks(clk_delay);
 233:../../libdaisy/src/dev/oled_ssd130x.h **** 
 234:../../libdaisy/src/dev/oled_ssd130x.h ****             pin_sclk_.Toggle();
 235:../../libdaisy/src/dev/oled_ssd130x.h **** 
 236:../../libdaisy/src/dev/oled_ssd130x.h ****             System::DelayTicks(clk_delay);
 237:../../libdaisy/src/dev/oled_ssd130x.h **** 
 238:../../libdaisy/src/dev/oled_ssd130x.h ****             pin_sclk_.Toggle();
 239:../../libdaisy/src/dev/oled_ssd130x.h ****         }
 240:../../libdaisy/src/dev/oled_ssd130x.h ****     }
 241:../../libdaisy/src/dev/oled_ssd130x.h **** 
 242:../../libdaisy/src/dev/oled_ssd130x.h ****     uint32_t clk_delay;
 243:../../libdaisy/src/dev/oled_ssd130x.h ****     GPIO     pin_sclk_;
 244:../../libdaisy/src/dev/oled_ssd130x.h ****     GPIO     pin_mosi_;
 245:../../libdaisy/src/dev/oled_ssd130x.h ****     GPIO     pin_reset_;
 246:../../libdaisy/src/dev/oled_ssd130x.h ****     GPIO     pin_dc_;
 247:../../libdaisy/src/dev/oled_ssd130x.h **** };
