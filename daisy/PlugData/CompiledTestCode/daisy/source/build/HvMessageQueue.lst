  59:HvMessageQueue.c **** HvMessage *mq_addMessage(HvMessageQueue *q, const HvMessage *m, int let,
  60:HvMessageQueue.c ****     void (*sendMessage)(HeavyContextInterface *, int, const HvMessage *)) {
  61:HvMessageQueue.c ****   MessageNode *node = mq_getOrCreateNodeFromPool(q);
  62:HvMessageQueue.c ****   node->m = mp_addMessage(&q->mp, m);
  63:HvMessageQueue.c ****   node->let = let;
  64:HvMessageQueue.c ****   node->sendMessage = sendMessage;
  65:HvMessageQueue.c ****   node->prev = NULL;
  66:HvMessageQueue.c ****   node->next = NULL;
  67:HvMessageQueue.c **** 
  68:HvMessageQueue.c ****   if (q->tail != NULL) {
  69:HvMessageQueue.c ****     // the list already contains elements
  70:HvMessageQueue.c ****     q->tail->next = node;
  71:HvMessageQueue.c ****     node->prev = q->tail;
  72:HvMessageQueue.c ****     q->tail = node;
  73:HvMessageQueue.c ****   } else {
  74:HvMessageQueue.c ****     // the list is empty
  75:HvMessageQueue.c ****     node->prev = NULL;
  76:HvMessageQueue.c ****     q->head = node;
