  36:HeavyContext.cpp **** HeavyContext::HeavyContext(double sampleRate, int poolKb, int inQueueKb, int outQueueKb) :
  37:HeavyContext.cpp ****     sampleRate(sampleRate) {
  38:HeavyContext.cpp **** 
  39:HeavyContext.cpp ****   hv_assert(sampleRate > 0.0); // sample rate must be positive
  40:HeavyContext.cpp ****   hv_assert(poolKb > 0);
  41:HeavyContext.cpp ****   hv_assert(inQueueKb > 0);
  42:HeavyContext.cpp ****   hv_assert(outQueueKb >= 0);
  43:HeavyContext.cpp **** 
  44:HeavyContext.cpp ****   blockStartTimestamp = 0;
  45:HeavyContext.cpp ****   printHook = nullptr;
  46:HeavyContext.cpp ****   userData = nullptr;
  47:HeavyContext.cpp **** 
  48:HeavyContext.cpp ****   // if outQueueKb is positive, then the outQueue is allocated and the default sendhook is set.
  49:HeavyContext.cpp ****   // Otherwise outQueue and the sendhook are set to NULL.
  50:HeavyContext.cpp ****   sendHook = (outQueueKb > 0) ? &defaultSendHook : nullptr;
  51:HeavyContext.cpp **** 
  52:HeavyContext.cpp ****   HV_SPINLOCK_RELEASE(inQueueLock);
  53:HeavyContext.cpp ****   HV_SPINLOCK_RELEASE(outQueueLock);
  54:HeavyContext.cpp **** 
  55:HeavyContext.cpp ****   numBytes = sizeof(HeavyContext);
  56:HeavyContext.cpp **** 
  57:HeavyContext.cpp ****   numBytes += mq_initWithPoolSize(&mq, poolKb);
  58:HeavyContext.cpp ****   numBytes += hLp_init(&inQueue, inQueueKb * 1024);
  59:HeavyContext.cpp ****   numBytes += hLp_init(&outQueue, outQueueKb * 1024); // outQueueKb value of 0 sets everything to N
  60:HeavyContext.cpp **** }
  61:HeavyContext.cpp **** 
  62:HeavyContext.cpp **** HeavyContext::~HeavyContext() {
  63:HeavyContext.cpp ****   mq_free(&mq);
  64:HeavyContext.cpp ****   hLp_free(&inQueue);
  65:HeavyContext.cpp ****   hLp_free(&outQueue);
  66:HeavyContext.cpp **** }
