  63:HvMessagePool.c **** static void ml_free(HvMessagePoolList *ml) {
  64:HvMessagePool.c ****   if (ml != NULL) {
  65:HvMessagePool.c ****     while (ml_hasAvailable(ml)) {
  66:HvMessagePool.c ****       ml_pop(ml);
  67:HvMessagePool.c ****     }
  68:HvMessagePool.c ****     while (ml->pool != NULL) {
  69:HvMessagePool.c ****       MessageListNode *n = ml->pool;
  70:HvMessagePool.c ****       ml->pool = n->next;
  71:HvMessagePool.c ****       hv_free(n);
  72:HvMessagePool.c ****     }
  73:HvMessagePool.c ****   }
  74:HvMessagePool.c **** }
