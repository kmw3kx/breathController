  27:HvMessagePool.c **** typedef struct MessageListNode {
  28:HvMessagePool.c ****   char *p;
  29:HvMessagePool.c ****   struct MessageListNode *next;
  30:HvMessagePool.c **** } MessageListNode;
  31:HvMessagePool.c **** 
  32:HvMessagePool.c **** static inline bool ml_hasAvailable(HvMessagePoolList *ml) {
  33:HvMessagePool.c ****   return (ml->head != NULL);
  34:HvMessagePool.c **** }
  35:HvMessagePool.c **** 
  36:HvMessagePool.c **** static char *ml_pop(HvMessagePoolList *ml) {
  37:HvMessagePool.c ****   MessageListNode *n = ml->head;
  38:HvMessagePool.c ****   ml->head = n->next;
  39:HvMessagePool.c ****   n->next = ml->pool;
  40:HvMessagePool.c ****   ml->pool = n;
  41:HvMessagePool.c ****   char *const p = n->p;
  42:HvMessagePool.c ****   n->p = NULL; // set to NULL to make it clear that this node does not have a valid buffer
  43:HvMessagePool.c ****   return p;
  44:HvMessagePool.c **** }
  45:HvMessagePool.c **** 
