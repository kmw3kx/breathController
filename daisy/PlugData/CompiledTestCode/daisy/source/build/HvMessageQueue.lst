 146:HvMessageQueue.c **** bool mq_removeMessage(HvMessageQueue *q, HvMessage *m, void (*sendMessage)(HeavyContextInterface *,
 147:HvMessageQueue.c ****   if (mq_hasMessage(q)) {
 148:HvMessageQueue.c ****     if (mq_node_getMessage(q->head) == m) { // msg in head node
 149:HvMessageQueue.c ****       // only remove the message if sendMessage is the same as the stored one,
 150:HvMessageQueue.c ****       // if the sendMessage argument is NULL, it is not checked and will remove any matching messag
 151:HvMessageQueue.c ****       if (sendMessage == NULL || q->head->sendMessage == sendMessage) {
 152:HvMessageQueue.c ****         mq_pop(q);
 153:HvMessageQueue.c ****         return true;
 154:HvMessageQueue.c ****       }
 155:HvMessageQueue.c ****     } else {
 156:HvMessageQueue.c ****       MessageNode *prevNode = q->head;
 157:HvMessageQueue.c ****       MessageNode *currNode = q->head->next;
 158:HvMessageQueue.c ****       while ((currNode != NULL) && (currNode->m != m)) {
 159:HvMessageQueue.c ****         prevNode = currNode;
 160:HvMessageQueue.c ****         currNode = currNode->next;
 161:HvMessageQueue.c ****       }
 162:HvMessageQueue.c ****       if (currNode != NULL) {
 163:HvMessageQueue.c ****         if (sendMessage == NULL || currNode->sendMessage == sendMessage) {
 164:HvMessageQueue.c ****           mp_freeMessage(&q->mp, m);
 165:HvMessageQueue.c ****           currNode->m = NULL;
 166:HvMessageQueue.c ****           currNode->let = 0;
 167:HvMessageQueue.c ****           currNode->sendMessage = NULL;
 168:HvMessageQueue.c ****           if (currNode == q->tail) { // msg in tail node
